# Required server-only configuration
MONGODB_URI=<NEW_ROTATED_MONGODB_URI>
MONGODB_DB_NAME=artdera
AUTH_SECRET=<GENERATE_AT_LEAST_32_RANDOM_CHARACTERS>
APP_URL=https://www.artdera.com
# Optional comma-separated additional browser origins. Same-origin Vercel
# preview URLs are accepted automatically.
ALLOWED_ORIGINS=https://artdera.com,https://www.artdera.com,https://artdera-global-canvas.vercel.app
API_PORT=3001
NODE_ENV=production
# Used only by the local Vite server. Production remains same-origin.
API_PROXY_TARGET=http://127.0.0.1:3001

# Development payment adapter. Disable in production.
DEMO_PAYMENT_MODE=false
PAYMENT_PROVIDER=manual

# Upload adapter
# Use mongodb on Vercel for persistent GridFS storage.
UPLOAD_PROVIDER=mongodb
UPLOAD_DIR=uploads
MAX_ARTWORK_IMAGE_SIZE_MB=10
MAX_PROFILE_IMAGE_SIZE_MB=5
MAX_PAYMENT_PROOF_SIZE_MB=5

# Manual checkout receiving accounts — server-only. Never prefix these with VITE_.
JAZZCASH_ACCOUNT_TITLE=<VERIFIED_ACCOUNT_TITLE>
JAZZCASH_ACCOUNT_NUMBER=<VERIFIED_ACCOUNT_NUMBER>
EASYPAISA_ACCOUNT_TITLE=<VERIFIED_ACCOUNT_TITLE>
EASYPAISA_ACCOUNT_NUMBER=<VERIFIED_ACCOUNT_NUMBER>
HBL_ACCOUNT_TITLE=<VERIFIED_ACCOUNT_TITLE>
HBL_ACCOUNT_NUMBER=<VERIFIED_ACCOUNT_NUMBER>
HBL_IBAN=<VERIFIED_PK_IBAN>
# Optional same-origin QR image path, for example /images/payment-qr.png
HBL_QR_CODE_PATH=

# Explicit admin:create command only
ADMIN_NAME=ArtDera Administrator
ADMIN_EMAIL=<ADMIN_EMAIL>
ADMIN_PASSWORD=<GENERATE_AT_LEAST_14_RANDOM_CHARACTERS>

# Leave unset for same-origin /uploads URLs.
UPLOAD_PUBLIC_BASE_URL=

# Email / Resend — required in production for password-reset emails.
# Leave blank in development to fall back to console logging.
# Obtain your key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sender address shown in password-reset emails.
# Must be verified in your Resend dashboard (artdera.com domain).
EMAIL_FROM=ArtDera <security@artdera.com>
